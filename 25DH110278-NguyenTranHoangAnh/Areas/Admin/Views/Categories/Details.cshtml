@model _25DH110278_NguyenTranHoangAnh.Models.Category

@{
    ViewBag.Title = "Chi tiết danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-info" style="padding: 10px; border-radius: 4px;">CHI TIẾT DANH MỤC: @Model.CategoryName</h2>

<div>
    <dl class="dl-horizontal">
        <dt>Mã danh mục</dt>
        <dd>@Model.CategoryID</dd>

        <dt>Tên danh mục</dt>
        <dd>@Model.CategoryName</dd>

        <dt>Tổng số sản phẩm</dt>
        <dd><span class="badge" style="background-color: #337ab7;">@(Model.Products != null ? Model.Products.Count : 0)</span></dd>
    </dl>
</div>

<h3 style="margin-top: 25px; margin-bottom: 15px;">DANH SÁCH SẢN PHẨM THUỘC DANH MỤC</h3>

@if (Model.Products != null && Model.Products.Any())
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr class="bg-primary">
                <th>Ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Đơn giá</th>
                <th>Tồn kho</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Products)
            {
                <tr>
                    <td style="width: 80px;">
                        @if (!string.IsNullOrEmpty(item.ProductImage))
                        {
                            <img src="@Url.Content(item.ProductImage)" alt="@item.ProductName" style="height: 50px; width: 50px; object-fit: cover;" />
                        }
                    </td>
                    <td>@item.ProductName</td>
                    <td>@item.ProductPrice.ToString("N0") đ</td>
                    <td><span class="badge">@item.Quantity</span></td>
                    <td>
                        @Html.ActionLink("Chi tiết", "Details", "Products", new { id = item.ProductID }, new { @class = "btn btn-info btn-xs" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">Chưa có sản phẩm nào thuộc danh mục này.</div>
}

<p style="margin-top: 20px;">
    @Html.ActionLink("Sửa", "Edit", new { id = Model.CategoryID }, new { @class = "btn btn-warning" })
    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
</p>
