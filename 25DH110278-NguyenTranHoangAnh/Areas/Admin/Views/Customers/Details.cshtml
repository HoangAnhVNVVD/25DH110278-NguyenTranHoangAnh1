@model _25DH110278_NguyenTranHoangAnh.Models.Customer

@{
    ViewBag.Title = "Chi tiết khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-info" style="padding: 10px; border-radius: 4px;">CHI TIẾT KHÁCH HÀNG: @Model.CustomerName</h2>

<div>
    <dl class="dl-horizontal">
        <dt>Mã khách hàng</dt>
        <dd>@Model.CustomerID</dd>

        <dt>Họ và tên</dt>
        <dd>@Model.CustomerName</dd>

        <dt>Số điện thoại</dt>
        <dd>@Model.CustomerPhone</dd>

        <dt>Email</dt>
        <dd>@Model.CustomerEmail</dd>

        <dt>Địa chỉ</dt>
        <dd>@Model.CustomerAddress</dd>

        <dt>Tên đăng nhập</dt>
        <dd>@Model.Username</dd>
    </dl>
</div>

<h3 style="margin-top: 30px; margin-bottom: 15px;">LỊCH SỬ ĐƠN HÀNG ĐÃ MUA</h3>

@if (Model.Orders != null && Model.Orders.Any())
{
    <table class="table table-bordered table-hover">
        <thead class="bg-primary">
            <tr>
                <th>Mã đơn hàng</th>
                <th>Ngày đặt</th>
                <th>Tổng tiền</th>
                <th>Trạng thái</th>
                <th>Địa chỉ giao hàng</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model.Orders.OrderByDescending(o => o.OrderID))
            {
                <tr>
                    <td>#@order.OrderID</td>
                    <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td style="font-weight: bold; color: #d9534f;">@order.TotalAmount.ToString("N0") đ</td>
                    <td><span class="label label-info">@order.PaymentStatus</span></td>
                    <td>@order.AddressDelivery</td>
                    <td>
                        @Html.ActionLink("Xem chi tiết", "DetailedOrder", "Orders", new { id = order.OrderID }, new { @class = "btn btn-info btn-xs" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">Khách hàng này chưa có đơn hàng nào.</div>
}

<p style="margin-top: 20px;">
    @Html.ActionLink("Sửa thông tin", "Edit", new { id = Model.CustomerID }, new { @class = "btn btn-warning" })
    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
</p>
