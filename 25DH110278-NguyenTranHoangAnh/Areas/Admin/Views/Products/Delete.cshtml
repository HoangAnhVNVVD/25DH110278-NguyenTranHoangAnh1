@model _25DH110278_NguyenTranHoangAnh.Models.Product

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-info">XÓA SẢN PHẨM</h2>

<h4>Bạn thực sự muốn xóa sản phẩm này à?</h4>

@Html.Partial("PVProductInfo", Model)

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="form-actions no-color" style="padding: 10px 0;">
        <input type="submit" value="Xóa" class="btn btn-primary" />
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary" })
    </div>
}
