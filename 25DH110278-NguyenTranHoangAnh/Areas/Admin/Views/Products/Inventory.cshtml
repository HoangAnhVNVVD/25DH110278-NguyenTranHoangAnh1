@model _25DH110278_NguyenTranHoangAnh.Models.ViewModel.InventoryVM

@{
    ViewBag.Title = "Quản lý kho hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 style="margin-top: 20px; margin-bottom: 25px; font-weight: bold;">QUẢN LÝ KHO HÀNG</h2>

<div class="panel panel-danger">
    <div class="panel-heading" style="font-weight: bold; font-size: 16px;">
        <span class="glyphicon glyphicon-warning-sign"></span> DANH SÁCH HÀNG CẦN NHẬP (HẾT HÀNG)
    </div>
    <div class="panel-body">
        @if (Model.OutOfStockProducts != null && Model.OutOfStockProducts.Any())
        {
            <table class="table table-bordered table-hover">
                <thead style="background-color: #f2dede;">
                    <tr>
                        <th style="width: 80px;">Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Đơn giá</th>
                        <th class="text-center">Số lượng tồn</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OutOfStockProducts)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ProductImage))
                                {
                                    <img src="@Url.Content(item.ProductImage)" alt="@item.ProductName" style="height: 50px; width: 50px; object-fit: cover;" />
                                }
                            </td>
                            <td><strong>@item.ProductName</strong></td>
                            <td>@(item.Category != null ? item.Category.CategoryName : "")</td>
                            <td>@item.ProductPrice.ToString("N0") đ</td>
                            <td class="text-center"><span class="label label-danger">0 (Hết hàng)</span></td>
                            <td>
                                @Html.ActionLink("Nhập thêm hàng", "Edit", new { id = item.ProductID }, new { @class = "btn btn-warning btn-sm" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-success">Hiện không có sản phẩm nào bị hết hàng.</div>
        }
    </div>
</div>

<div class="panel panel-success" style="margin-top: 30px;">
    <div class="panel-heading" style="font-weight: bold; font-size: 16px;">
        <span class="glyphicon glyphicon-ok-sign"></span> DANH SÁCH HÀNG TỒN (CÒN HÀNG TRONG KHO)
    </div>
    <div class="panel-body">
        @if (Model.InStockProducts != null && Model.InStockProducts.Any())
        {
            <table class="table table-bordered table-hover">
                <thead style="background-color: #dff0d8;">
                    <tr>
                        <th style="width: 80px;">Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Đơn giá</th>
                        <th class="text-center">Số lượng tồn</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.InStockProducts)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ProductImage))
                                {
                                    <img src="@Url.Content(item.ProductImage)" alt="@item.ProductName" style="height: 50px; width: 50px; object-fit: cover;" />
                                }
                            </td>
                            <td><strong>@item.ProductName</strong></td>
                            <td>@(item.Category != null ? item.Category.CategoryName : "")</td>
                            <td>@item.ProductPrice.ToString("N0") đ</td>
                            <td class="text-center"><span class="badge" style="background-color: #5cb85c;">@item.Quantity</span></td>
                            <td>
                                @Html.ActionLink("Cập nhật số lượng", "Edit", new { id = item.ProductID }, new { @class = "btn btn-info btn-sm" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-warning">Kho hàng hiện đang trống.</div>
        }
    </div>
</div>
