@model _25DH110278_NguyenTranHoangAnh.Models.Customer

@{
    ViewBag.Title = "Thông tin tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="bg-primary text-white" style="padding: 10px; border-radius: 4px;">THÔNG TIN TÀI KHOẢN</h2>

@if (ViewBag.Message != null)
{
    <div class="alert alert-success">@ViewBag.Message</div>
}

@using (Html.BeginForm("ProfileInfo", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.CustomerID)
    @Html.HiddenFor(m => m.Username)

    <div class="form-group">
        <label class="col-md-2 control-label">Tên đăng nhập:</label>
        <div class="col-md-10">
            <input type="text" class="form-control" value="@Model.Username" readonly="readonly" />
        </div>
    </div>

    <div class="form-group">
        <label class="col-md-2 control-label">Họ và tên:</label>
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.CustomerName, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <label class="col-md-2 control-label">Số điện thoại:</label>
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.CustomerPhone, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.CustomerPhone, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <label class="col-md-2 control-label">Email:</label>
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.CustomerEmail, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.CustomerEmail, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <label class="col-md-2 control-label">Địa chỉ:</label>
        <div class="col-md-10">
            @Html.TextAreaFor(m => m.CustomerAddress, new { @class = "form-control", rows = 3 })
            @Html.ValidationMessageFor(m => m.CustomerAddress, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Lưu thay đổi" class="btn btn-success" />
            @Html.ActionLink("Về Trang chủ", "Index", "Home", null, new { @class = "btn btn-default" })
        </div>
    </div>
}