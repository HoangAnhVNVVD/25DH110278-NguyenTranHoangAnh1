@model _25DH110278_NguyenTranHoangAnh.Models.ViewModel.Cart

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    @if (Model == null || !Model.Items.Any())
    {
        <p>Chưa có sản phẩm nào trong giỏ.</p>
    }
    else
    {
        <div class="cart-section">
            @foreach (var categoryGroup in Model.GroupedItems)
            {
                <h3 style="color: brown; font-weight: bold;">@categoryGroup.Key</h3>
                <table class="table cart-section table-bordered">
                    <thead>
                        <tr class="bg-info">
                            <th>Hình ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th>Đơn giá</th>
                            <th>Số lượng</th>
                            <th>Thành tiền</th>
                            <th>
                                <a href="@Url.Action("ClearCart", "Cart")" title="Xóa tất cả mặt hàng trong giỏ" class="btn btn-warning btn-xs">
                                    <span class="glyphicon glyphicon-trash"></span>
                                </a>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in categoryGroup)
                        {
                            <tr>
                                <td style="text-align: center;">
                                    <img src="@item.ProductImage" style="max-height:80px; max-width:80px;" />
                                </td>
                                <td>@item.ProductName</td>
                                <td>@item.UnitPrice.ToString("N0")</td>
                                <td>
                                    @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post))
                                    {
                                        <input type="hidden" name="id" value="@item.ProductID" />
                                        <button type="button" style="width:20px;" onclick="cartUpdateQuantity(@item.ProductID, @item.Quantity - 1)">-</button>
                                        <input type="number" name="quantity" value="@item.Quantity" max="100" readonly style="width:40px; text-align:right;" />
                                        <button type="button" style="width:20px;" onclick="cartUpdateQuantity(@item.ProductID, @item.Quantity + 1)">+</button>
                                    }
                                </td>
                                <td>@item.TotalPrice.ToString("N0")</td>
                                <td>
                                    <a href="@Url.Action("RemoveFromCart", "Cart", new { id = item.ProductID })" class="btn btn-danger btn-xs">
                                        <span class="glyphicon glyphicon-remove"></span>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
        <div class="cart-section" style="margin: 20px 0;">
            <div><strong>Tổng giá trị: &nbsp; <span style="color:red; font-size: 18px;">@Model.TotalValue().ToString("N0")</span></strong></div>
            <div style="margin-top: 10px;">
                @Html.ActionLink("Mua hàng", "Checkout", "Order", null, new { @class = "btn btn-danger cart-button" })
            </div>
        </div>
        <div class="col-md-12 cart-section">
            @Html.Partial("_PVSimilarProduct", Model)
        </div>
        <div style="margin-top: 20px; margin-bottom: 30px;">
            @Html.ActionLink("Tiếp tục mua hàng", "Index", "Home", null, new { @class = "btn btn-warning cart-button" })
        </div>
    }
</div>

<script>
    function cartUpdateQuantity(id, quantity) {
        if (quantity > 0) {
            $.ajax({
                url: '@Url.Action("UpdateQuantity", "Cart")',
                type: 'POST',
                data: { id: id, quantity: quantity },
                success: function () {
                    location.reload();
                }
            });
        }
    }
</script>
