@model _25DH110278_NguyenTranHoangAnh.Models.ViewModel.Cart
@using PagedList.Mvc
@using PagedList

@if (Model != null && Model.SimilarProducts != null && Model.SimilarProducts.Any())
{
    <section>
        <h2>Sản phẩm tương tự</h2>
        <div class="list-container" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(140px, 1fr)); gap:10px;">
            @foreach (var product in Model.SimilarProducts)
            {
                <div class="lproduct-item" style="border:1px groove #ddd; border-radius:10px; text-align:center; padding:10px;">
                    <div>
                        <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                            <img src="@product.ProductImage" style="max-height:120px; max-width:120px;" />
                        </a>
                    </div>
                    <div style="font-weight:bold; margin-top:5px;">@product.ProductName</div>
                    <div class="prodPrice" style="color:blue; font-weight:bold; margin:5px 0;">@product.ProductPrice.ToString("N0") &nbsp; đ</div>
                    <div>
                        @Html.ActionLink("Thêm vào giỏ hàng", "AddToCart", "Cart", new { id = product.ProductID }, new { @class = "btn btn-info btn-xs" })
                    </div>
                </div>
            }
        </div>
    </section>
    <div class="pagination-container" style="text-align:center; margin-top:10px;">
        @Html.PagedListPager(Model.SimilarProducts, page => Url.Action("Index", new { page }))
    </div>
}
