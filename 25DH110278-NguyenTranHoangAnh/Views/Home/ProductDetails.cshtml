@model _25DH110278_NguyenTranHoangAnh.Models.ViewModel.ProductDetailsVM

@{
    ViewBag.Title = "ProductDetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .pro {
        padding: 50px 10px 50px 10px;
        background-color: ghostwhite;
    }
    .pro-section {
        background-color: white;
        border: 1px groove #ffffff;
        border-radius: 10px;
        padding: 10px;
        margin: 10px;
    }
    .pro-section img {
        max-height: 250px;
        max-width: 250px;
        padding: 5px;
    }
    .pro-price {
        font-weight: bolder;
        font-size: larger;
        color: red;
    }
    .pro-sale {
        font-weight: lighter;
    }
</style>

<div class="container-fluid pro">
    <div class="col-md-3 pro-section text-center">
        @if (Model.product != null && !string.IsNullOrEmpty(Model.product.ProductImage))
        {
            <img src="@Url.Content(Model.product.ProductImage)" alt="@Model.product.ProductName" class="img-responsive" style="margin: 0 auto;" />
        }
    </div>
    <div class="col-md-5 pro-section">
        <div>
            <h4><strong>@Html.DisplayFor(model => model.product.ProductName)</strong></h4>
            <p>Đã bán: @(Model.product.OrderDetails != null ? Model.product.OrderDetails.Count : 0)</p>
            <p class="pro-price">@Model.product.ProductPrice.ToString("N0") đ</p>
            <p>Danh mục: @(Model.product.Category != null ? Model.product.Category.CategoryName : "")</p>
            <hr />
            <h5><strong>Mô tả</strong></h5>
            <p>@Model.product.ProductDescription</p>
        </div>
        <hr />
        <div>
            @Html.Partial("_PVRelatedProduct", Model)
        </div>
    </div>
    <div class="col-md-3 pro-section">
        <div>
            @using (Html.BeginForm("ProductDetails", "Home", FormMethod.Get))
            {
                @Html.Hidden("id", Model.product.ProductID)
                <h4><strong>Số lượng:</strong></h4>
                @Html.TextBoxFor(model => model.quantity, new { @class = "form-control", @type = "number", @min = "1" })
                <h4><strong>Tạm tính:</strong></h4>
                <p class="pro-price">@Model.estimatedValue.ToString("N0") đ</p>
                <button type="submit" class="btn btn-default">Cập nhật giá</button>
            }
            <div style="margin-top: 10px;">
                @Html.ActionLink("Thêm vào giỏ hàng", "AddToCart", "Cart", new { id = Model.product.ProductID, quantity = Model.quantity }, new { @class = "btn btn-info" })
            </div>
        </div>
        <hr />
        <div>
            @Html.Partial("_PVTopProduct", Model)
        </div>
    </div>
</div>
