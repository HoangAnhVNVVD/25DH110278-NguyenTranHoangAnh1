@model _25DH110278_NguyenTranHoangAnh.Models.ViewModel.ProductDetailsVM
@using PagedList.Mvc

@if (Model != null && Model.RelatedProducts != null && Model.RelatedProducts.Any())
{
    <section class="container-fluid featureProd">
        <h4 style="font-weight:bold;">Sản phẩm tương tự</h4>
        <div class="feature-container" style="display:flex; overflow-x:auto;">
            @foreach (var product in Model.RelatedProducts)
            {
                <div class="fproduct-item" style="min-width:160px; margin:10px; border:1px groove #ddd; border-radius:10px; text-align:center;">
                    <div>
                        <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                            @if (!string.IsNullOrEmpty(product.ProductImage))
                            {
                                <img src="@Url.Content(product.ProductImage)" alt="@product.ProductName" style="max-height:160px; max-width:140px; padding:5px; object-fit:contain;" />
                            }
                        </a>
                    </div>
                    <div>
                        <h5 style="height:36px; overflow:hidden;">@product.ProductName</h5>
                        <p class="prodPrice" style="color:blue; font-weight:bold;">@product.ProductPrice.ToString("N0") đ</p>
                    </div>
                </div>
            }
        </div>
    </section>
}
