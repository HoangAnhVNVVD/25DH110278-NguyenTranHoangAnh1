@model _25DH110278_NguyenTranHoangAnh.Models.ViewModel.ProductDetailsVM
@using PagedList.Mvc

@if (Model != null && Model.TopProducts != null && Model.TopProducts.Any())
{
    <section class="container-fluid listProduct">
        <h4 style="font-weight:bold;">Sản phẩm bán chạy</h4>
        <div class="list-container" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(140px, 1fr)); gap:10px;">
            @foreach (var product in Model.TopProducts)
            {
                <div class="lproduct-item" style="border:1px groove #ddd; border-radius:10px; text-align:center; padding:5px;">
                    <div>
                        <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                            @if (!string.IsNullOrEmpty(product.ProductImage))
                            {
                                <img src="@Url.Content(product.ProductImage)" alt="@product.ProductName" style="max-height:120px; max-width:120px; padding:5px; object-fit:contain;" />
                            }
                        </a>
                    </div>
                    <div>
                        <h5 style="font-size:13px; height:32px; overflow:hidden;">@product.ProductName</h5>
                        <p class="prodPrice" style="color:blue; font-weight:bold;">@product.ProductPrice.ToString("N0") đ</p>
                    </div>
                </div>
            }
        </div>
    </section>
    <div class="pagination-container" style="text-align:center; margin-top:10px;">
        @Html.PagedListPager(Model.TopProducts, page => Url.Action("ProductDetails", new { id = Model.product.ProductID, quantity = Model.quantity, page }))
    </div>
}
