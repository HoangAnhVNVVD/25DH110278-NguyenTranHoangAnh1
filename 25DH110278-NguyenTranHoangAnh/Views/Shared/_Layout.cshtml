<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - MyStore</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <style>
        body { padding-top: 70px; }
        .navbar-nav .nav-link { color: rgba(255,255,255,.85) !important; font-size: 15px; padding: 8px 14px !important; }
        .navbar-nav .nav-link:hover { color: #fff !important; }
        .dropdown-menu { background-color: #fff; }
        .dropdown-item { color: #333 !important; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container">
            @Html.ActionLink("MYSTORE", "Index", "Home", new { area = "" }, new { @class = "navbar-brand fw-bold" })
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">@Html.ActionLink("Trang chủ", "Index", "Home", null, new { @class = "nav-link" })</li>
                    @Html.Action("CategoryMenu", "Home")
                    <li class="nav-item">@Html.ActionLink("Quản trị", "Index", "Home", new { area = "Admin" }, new { @class = "nav-link" })</li>
                </ul>
                @Html.Action("PersonalMenu", "Home")
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Website Bán Hàng MyStore</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
